---
import { categories, withBase } from '../lib/content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'my philosophy',
  description = '考え方を、完成品ではなく変化するものとして残す。',
} = Astro.props;
const fullTitle = title === 'my philosophy' ? title : `${title} | my philosophy`;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL(withBase('og.png'), site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={withBase()}>my philosophy</a>
      <nav aria-label="主なカテゴリ">
        <a href={withBase('principles/')}>原則</a>
        <a href={withBase('beliefs/')}>信念</a>
        <a href={withBase('frameworks/')}>思考の型</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>考えは、経験によって変わる。変わった理由まで残す。</p>
      <div class="footer-links">
        {categories.slice(0, 7).map((category) => (
          <a href={withBase(`${category.id}/`)}>{category.label}</a>
        ))}
      </div>
    </footer>
  </body>
</html>
