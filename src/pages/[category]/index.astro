---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  categories,
  categoryIdFromEntry,
  entryDate,
  entrySlug,
  entryTitle,
  isPublished,
  sortEntries,
  withBase,
  type CategoryId,
} from '../../lib/content';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const all = sortEntries(
  (await getCollection('documents')).filter(
    (entry) => categoryIdFromEntry(entry) === (category.id as CategoryId),
  ),
);
const entries = all.filter(isPublished);
const questions = all.filter((entry) => !isPublished(entry));
---

<BaseLayout title={category.title} description={category.description}>
  <header class="page-intro">
    <a class="back-link" href={withBase()}>← すべてのカテゴリ</a>
    <p class="eyebrow">{category.label}</p>
    <h1>{category.title}</h1>
    <p>{category.description}</p>
  </header>

  <section class="collection-list" aria-label={`${category.title}の記事`}>
    {entries.length === 0 ? (
      <p class="empty-state">まだ書けるだけの根拠が集まっていません。</p>
    ) : (
      entries.map((entry) => (
        <article class="collection-item">
          <div>
            <span class={`status status-${entry.data.status}`}>
              {entry.data.status === 'evolving' ? '更新中' : '公開'}
            </span>
            <h2><a href={withBase(`${entrySlug(entry)}/`)}>{entryTitle(entry)}</a></h2>
            {entry.data.description && <p>{entry.data.description}</p>}
          </div>
          {entryDate(entry) && (
            <time datetime={entryDate(entry)!.toISOString()}>
              {entryDate(entry)!.toLocaleDateString('ja-JP')}
            </time>
          )}
        </article>
      ))
    )}
  </section>

  {questions.length > 0 && (
    <section class="open-questions" aria-labelledby="open-questions-heading">
      <div class="section-heading">
        <p class="eyebrow">Open questions</p>
        <h2 id="open-questions-heading">育てている問い</h2>
      </div>
      <p class="open-questions-note">
        まだ主張として書けていない問いです。<br />
        判断の根拠が繰り返し集まった時点で、ページとして公開します。
      </p>
      <ul class="question-list">
        {questions.map((entry) => (
          <li>
            <span class="question-title">{entryTitle(entry)}</span>
            {entry.data.description && <span class="question-description">{entry.data.description}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
